                    $"💠 @{user} PULLED IT! {itemName} [Rare] secured! {equipNote} Well played! 🎉",
                    $"💠 YES! @{user} claims the {itemName} [Rare]! {equipNote} The gacha delivers! 🎉",
                    $"💠 @{user} walks away victorious with {itemName} [Rare]! {equipNote} Nicely done! 🎉",
                };
                return rareSuccess[rng.Next(rareSuccess.Length)];

            case "Ultra-Rare":
                string[] ultraSuccess = {
                    $"🔥🔥 ULTRA-RARE PULL! @{user} has claimed {itemName}! {equipNote} Incredible luck! PogChamp 🔥",
                    $"🔥🔥 @{user} DOES IT! {itemName} [Ultra-Rare] is theirs! {equipNote} Chat, are you seeing this?! 🔥",
                    $"🔥🔥 THE GACHA YIELDS! @{user} pulls {itemName} [Ultra-Rare]! {equipNote} What a moment! 🔥",
                };
                return ultraSuccess[rng.Next(ultraSuccess.Length)];

            case "Legendary":
                string[] legendSuccess = {
                    $"🌟🌟🌟 LEGENDARY!!! @{user} HAS PULLED {itemName}!!! THIS IS HISTORY! {equipNote} CHAT EXPLODE! 🌟🌟🌟",
                    $"🌟🌟🌟 THE IMPOSSIBLE! @{user} CLAIMS THE LEGENDARY {itemName}! {equipNote} WE ARE WITNESSING GREATNESS! 🌟🌟🌟",
                    $"🌟🌟🌟 LEGENDARY OBTAINED! @{user} AND {itemName} ARE NOW ONE! {equipNote} BOW DOWN TO THE CHOSEN ONE! 🌟🌟🌟",
                };
