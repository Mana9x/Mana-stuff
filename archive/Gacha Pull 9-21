    }

    // ── Fail messages — retry prompt uses slot number so no typing required ──
    private string GetFailMessage(string user, string itemName, string rarity, string slotNumber)
    {
        switch (rarity)
        {
            case "Rare":
                string[] rareFail = {
                    $"💠 @{user} came up empty this time... {itemName} slipped away. Fortune favors the persistent — try again with !pull {slotNumber}!",
                    $"💠 Not this time, @{user}! {itemName} wasn't meant to be today. Keep at it with !pull {slotNumber}!",
                    $"💠 @{user} reaches in but pulls nothing... {itemName} remains just out of reach. Don't stop now — !pull {slotNumber}!",
                };
                return rareFail[rng.Next(rareFail.Length)];

            case "Ultra-Rare":
                string[] ultraFail = {
                    $"🔥 @{user} fought for {itemName} but it fades away... So close! The ultra-rare still awaits — !pull {slotNumber}!",
                    $"🔥 The gacha holds on to {itemName} for now, @{user}. It won't resist forever... !pull {slotNumber}!",
                    $"🔥 @{user} reaches deep but {itemName} slips through their fingers... The hunt continues — !pull {slotNumber}!",
                };
                return ultraFail[rng.Next(ultraFail.Length)];

            case "Legendary":
                string[] legendFail = {
                    $"⚡ @{user} gave everything but {itemName} remains unclaimed... Legends are not won easily. Destiny will come. !pull {slotNumber}",
                    $"⚡ The LEGENDARY {itemName} holds firm against @{user} today... but the story isn't over. Keep pulling — !pull {slotNumber}!",
                    $"⚡ @{user} and {itemName} were not fated to meet today... The legend endures. Will you rise to claim it? !pull {slotNumber}",
                };
                return legendFail[rng.Next(legendFail.Length)];

            default:
                return $"@{user} didn't pull {itemName} this time. Try again with !pull {slotNumber}!";
        }
    }
}
